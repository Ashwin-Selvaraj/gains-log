// Provider is rewritten by scripts/set-db-provider.mjs based on DATABASE_URL:
// sqlite for local `file:./dev.db`, postgresql for a postgres:// URL.
// Everything below is deliberately portable between the two — no enums, no
// Decimal, no native type attributes.

generator client {
  provider        = "prisma-client-js"
  // Managed by scripts/set-db-provider.mjs — ["relationJoins"] on Postgres, [] on SQLite.
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// One row per calendar day. `date` is a plain "YYYY-MM-DD" string in the
/// user's local timezone — storing it as text keeps "today" unambiguous no
/// matter which device or server timezone writes the row.
model DailyEntry {
  id           String  @id @default(cuid())
  date         String  @unique
  workoutDone  Boolean @default(false)
  walkDone     Boolean @default(false)
  learningDone Boolean @default(false)
  sleptWell    Boolean @default(false)
  weightKg     Float?
  sleepHours   Float?
  walkMinutes  Int?
  workoutNote  String  @default("")
  learningNote String  @default("")

  meetings Meeting[]
  meals    MealEntry[]
  sets     WorkoutSet[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
}

model Meeting {
  id      String @id @default(cuid())
  /// "HH:MM", 24-hour.
  time    String
  title   String
  entryId String
  entry   DailyEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([entryId])
}

model MealEntry {
  id       String  @id @default(cuid())
  name     String
  calories Int?
  protein  Int?
  /// "manual" | "preset" | "photo-estimate" — kept as text so the schema works
  /// on SQLite as well as Postgres.
  source   String  @default("manual")
  photoUrl String?
  entryId  String
  entry    DailyEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([entryId])
}

/// Single row (id is always "singleton"). Targets used to live in
/// src/lib/goals.ts as constants; they're here so they can be edited in the app.
model Settings {
  id                String @id @default("singleton")
  startWeightKg     Float  @default(68)
  goalWeightKg      Float  @default(85)
  proteinTarget     Int    @default(140)
  caloriesMin       Int    @default(2800)
  caloriesMax       Int    @default(3100)
  /// Training sessions per week the plan is aiming for.
  weeklyWorkoutGoal Int    @default(5)

  updatedAt DateTime @updatedAt
}

/// The weekly training split — one row per weekday, 0 = Sunday.
/// A repeating week rather than per-date assignment: that's how a program is
/// actually written, and it means a new week needs no data entry.
model PlanDay {
  id      String @id @default(cuid())
  weekday Int    @unique
  /// "Push", "Pull", "Legs", "Rest" …
  name    String

  exercises PlanExercise[]
}

model PlanExercise {
  id        String  @id @default(cuid())
  name      String
  /// Target sets, and target reps as free text so "8-12" or "AMRAP" both work.
  sets      Int     @default(3)
  reps      String  @default("8-12")
  position  Int     @default(0)
  planDayId String
  planDay   PlanDay @relation(fields: [planDayId], references: [id], onDelete: Cascade)

  @@index([planDayId])
}

/// One actual set performed. The plan says what to do; this records what happened.
model WorkoutSet {
  id       String @id @default(cuid())
  exercise String
  reps     Int
  weightKg Float?
  entryId  String
  entry    DailyEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([entryId])
}

model MealPreset {
  id       String @id @default(cuid())
  name     String
  calories Int?
  protein  Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
