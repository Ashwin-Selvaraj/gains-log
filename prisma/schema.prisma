// Provider is rewritten by scripts/set-db-provider.mjs based on DATABASE_URL:
// sqlite for local `file:./dev.db`, postgresql for a postgres:// URL.
// Everything below is deliberately portable between the two — no enums, no
// Decimal, no native type attributes.

generator client {
  provider        = "prisma-client-js"
  // Managed by scripts/set-db-provider.mjs — ["relationJoins"] on Postgres, [] on SQLite.
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// One row per calendar day. `date` is a plain "YYYY-MM-DD" string in the
/// user's local timezone — storing it as text keeps "today" unambiguous no
/// matter which device or server timezone writes the row.
model DailyEntry {
  /// Owner. Every query is scoped by this; see requireUser() in src/lib/auth.ts.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  id           String  @id @default(cuid())
  date         String
  workoutDone  Boolean @default(false)
  learningDone Boolean @default(false)
  sleptWell    Boolean @default(false)
  /// Water replaced Walk as the fourth habit: walking was ambiguous to log,
  /// hydration is unambiguous and directly relevant to training.
  waterDone    Boolean @default(false)
  /// Litres drunk.
  waterLitres  Float?
  weightKg     Float?
  sleepHours   Float?

  /// Deprecated — the fourth habit before Water. Retained rather than dropped
  /// because days already logged really did record a walk, and rewriting those
  /// ticks as water would be inventing history. Hidden in the UI; safe to drop
  /// once the old days stop mattering.
  walkDone     Boolean @default(false)
  walkMinutes  Int?
  workoutNote  String  @default("")
  learningNote String  @default("")

  meetings Meeting[]
  meals    MealEntry[]
  sets     WorkoutSet[]
  photos   Photo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}

model Meeting {
  /// Owner. Every query is scoped by this; see requireUser() in src/lib/auth.ts.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  id      String     @id @default(cuid())
  /// "HH:MM", 24-hour.
  time    String
  title   String
  entryId String
  entry   DailyEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  /// Google Calendar event id, set once the meeting has been pushed there.
  /// Null means it lives only in this app. Storing the id is what makes the
  /// sync two-way enough to matter: editing or deleting the meeting here can
  /// find the event it created rather than leaving an orphan on the calendar.
  calendarEventId String?
  /// Why the last sync attempt failed, surfaced in the UI. A calendar write
  /// crosses the network to Google and can fail long after the meeting was
  /// saved; failing silently would leave you trusting a reminder that is not
  /// actually on your calendar.
  calendarError   String?

  createdAt DateTime @default(now())

  @@index([entryId])
  @@index([userId])
}

model MealEntry {
  /// Owner. Every query is scoped by this; see requireUser() in src/lib/auth.ts.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  id       String     @id @default(cuid())
  name     String
  calories Int?
  /// Float, not Int, like the other macros: protein is the metric this whole
  /// app is built around, and rounding every meal to a whole gram drifts the
  /// daily total by a couple of grams against a 140 g target.
  protein  Float?
  carbs    Float?
  fat      Float?
  fiber    Float?
  /// The Food this was logged from, when it came from the database rather than
  /// free text. Kept for analytics only — the macros above are a *snapshot*, so
  /// correcting a Food's values later never silently rewrites logged history.
  foodId   String?
  /// Grams actually eaten, which the snapshot macros were computed from.
  grams    Float?
  /// "manual" | "preset" | "photo-estimate" — kept as text so the schema works
  /// on SQLite as well as Postgres.
  source   String     @default("manual")
  photoUrl String?
  entryId  String
  entry    DailyEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([entryId])
  @@index([userId])
}

/// One row per user. Targets used to live in src/lib/goals.ts as constants;
/// they're here so they can be edited in the app.
model Settings {
  id                String @id @default(cuid())
  /// One settings row per user; replaced the former "singleton" row.
  userId            String @unique
  user              User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Centimetres. Needed for BMI; null until asked for, so the profile can
  /// tell the difference between "not set" and a real value.
  heightCm          Float?
  startWeightKg     Float  @default(68)
  goalWeightKg      Float  @default(85)
  proteinTarget     Int    @default(140)
  caloriesMin       Int    @default(2800)
  caloriesMax       Int    @default(3100)
  /// Training sessions per week the plan is aiming for.
  weeklyWorkoutGoal Int    @default(5)

  /// Evening nudge if the day is still incomplete.
  reminderEnabled Boolean @default(false)
  /// "HH:MM" in the timezone below, not the server's.
  reminderTime    String  @default("21:00")
  /// IANA zone, captured from the browser. The server runs wherever it runs;
  /// "is it 9pm for you yet" can only be answered against your zone, not its.
  timezone        String  @default("Asia/Kolkata")

  updatedAt DateTime @updatedAt
}

/// A browser's push endpoint. One row per device that opted in — the same
/// account on a phone and a laptop are two subscriptions, and either can be
/// revoked independently by the browser at any time.
model PushSubscription {
  /// Owner. Every query is scoped by this; see requireUser() in src/lib/auth.ts.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  id        String @id @default(cuid())
  /// The push service URL. Unique: re-subscribing the same browser returns the
  /// same endpoint, and duplicates would mean duplicate notifications.
  endpoint  String @unique
  p256dh    String
  auth      String
  userAgent String @default("")

  createdAt    DateTime  @default(now())
  lastSentAt   DateTime?
  /// Consecutive send failures. A subscription that keeps failing is dead —
  /// the browser was uninstalled or permission revoked — and gets pruned.
  failureCount Int       @default(0)
}

/// One row per notification actually sent.
///
/// The (kind, date) uniqueness is the idempotency guard: the scheduler polls
/// rather than firing on an exact tick, so it can wake up many times in the
/// reminder window, and the insert failing is how it knows it already sent.
/// That also makes it survive an app restart at an awkward minute.
model NotificationLog {
  /// Owner. Every query is scoped by this; see requireUser() in src/lib/auth.ts.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  id      String   @id @default(cuid())
  kind    String
  date    String
  sentAt  DateTime @default(now())
  /// How many subscriptions it actually reached.
  reached Int      @default(0)

  @@unique([userId, kind, date])
  @@index([date])
}

/// The weekly training split — one row per weekday, 0 = Sunday.
/// A repeating week rather than per-date assignment: that's how a program is
/// actually written, and it means a new week needs no data entry.
model PlanDay {
  /// Owner. Every query is scoped by this; see requireUser() in src/lib/auth.ts.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  id      String @id @default(cuid())
  weekday Int
  /// "Push", "Pull", "Legs", "Rest" …
  name    String

  exercises PlanExercise[]

  @@unique([userId, weekday])
}

model PlanExercise {
  id          String  @id @default(cuid())
  name        String
  /// Matches WorkoutSet.exerciseKey so plan and actual line up by identity
  /// rather than by exact spelling.
  exerciseKey String  @default("")
  /// Target sets, and target reps as free text so "8-12" or "AMRAP" both work.
  sets        Int     @default(3)
  reps        String  @default("8-12")
  position    Int     @default(0)
  planDayId   String
  planDay     PlanDay @relation(fields: [planDayId], references: [id], onDelete: Cascade)

  @@index([planDayId])
}

/// One actual set performed. The plan says what to do; this records what happened.
model WorkoutSet {
  /// Owner. Every query is scoped by this; see requireUser() in src/lib/auth.ts.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  id          String     @id @default(cuid())
  /// Display name, exactly as typed.
  exercise    String
  /// Normalised identity (see exerciseKey() in src/lib/prs.ts). Without this,
  /// "Bench press" and "bench press" would keep separate personal records.
  exerciseKey String     @default("")
  reps        Int
  weightKg    Float?
  entryId     String
  entry       DailyEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([entryId])
  @@index([exerciseKey])
  @@index([exerciseKey, createdAt])
  @@index([userId, exerciseKey])
}

/// An exercise moved from a day it was missed onto a later day.
///
/// Stored rather than derived: "I skipped legs on Tuesday and I'll do it
/// Thursday" is a decision, not a fact that can be recomputed from the log.
/// It carries its own target sets/reps so that editing the weekly plan later
/// doesn't silently change what was promised.
model CarriedExercise {
  /// Owner. Every query is scoped by this; see requireUser() in src/lib/auth.ts.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  id          String @id @default(cuid())
  name        String
  exerciseKey String @default("")
  sets        Int    @default(3)
  reps        String @default("8-12")

  /// The day it was originally planned for, kept so the UI can say where it
  /// came from and the report can count what actually slipped.
  fromDate String
  /// The day it now appears on.
  toDate   String

  createdAt DateTime @default(now())

  @@index([toDate])
  @@index([fromDate])
  @@index([userId, toDate])
}

/// A photo attached to a day — a gym/progress shot, or the plate behind a meal.
/// The bytes live in Cloudflare R2; only the key and its public URL are stored
/// here. `key` is kept separately from `url` so the object can still be deleted
/// from the bucket if the public base URL ever changes (custom domain, etc.).
model Photo {
  /// Owner. Every query is scoped by this; see requireUser() in src/lib/auth.ts.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  id      String @id @default(cuid())
  /// "progress" | "meal" | "other" — also the top-level folder in the bucket.
  kind    String @default("progress")
  /// Object key within the bucket, e.g. "progress/2026/09/clx123.jpg".
  key     String @unique
  url     String
  caption String @default("")
  width   Int?
  height  Int?
  bytes   Int?

  entryId String
  entry   DailyEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  /// Set when the photo is the one behind a logged meal.
  mealId  String?

  createdAt DateTime @default(now())

  @@index([entryId])
  @@index([kind])
  @@index([userId, kind])
}

/// A canonical food with macros stored per 100 g — the single basis everything
/// derives from, so any portion is just a multiplication. Seeded from published
/// composition data (see prisma/foods.ts); every value is editable in the app
/// because published figures are averages and your dosa is not the average dosa.
model Food {
  id       String  @id @default(cuid())
  /// Null for the shared seeded table, which every user can read but not edit.
  /// Set for a food a user added themselves, visible only to them.
  userId   String?
  user     User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name     String
  /// Normalised name for lookup and search. Same idea as WorkoutSet.exerciseKey.
  nameKey  String
  /// Comma-separated lowercase alternates ("dosai,plain dosa") so both search
  /// and the photo estimator can find a food by whatever it was called.
  aliases  String  @default("")
  category String  @default("other")

  kcalPer100g    Float
  proteinPer100g Float
  carbsPer100g   Float
  fatPer100g     Float
  fiberPer100g   Float @default(0)

  /// Household portion, because nobody weighs 2 idlis. "1 idli" = 45 g.
  servingLabel String @default("100 g")
  servingGrams Float  @default(100)

  presetItems MealPresetItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Scoped to the owner so a personal "Dosa" can coexist with the shared one.
  @@unique([userId, nameKey])
  @@index([nameKey])
  @@index([userId])
  @@index([category])
}

/// A saved combination, e.g. "5 idlis + 2 eggs". Built from Food rows rather
/// than hardcoded numbers, so fixing a Food's macros fixes every preset using it.
model MealPreset {
  /// Owner. Every query is scoped by this; see requireUser() in src/lib/auth.ts.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  id    String           @id @default(cuid())
  name  String
  items MealPresetItem[]

  /// Legacy manual macros, for presets created before the food database and
  /// for one-off combinations with no matching Food. Used only when items is empty.
  calories Int?
  protein  Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model MealPresetItem {
  id       String     @id @default(cuid())
  presetId String
  preset   MealPreset @relation(fields: [presetId], references: [id], onDelete: Cascade)
  foodId   String
  food     Food       @relation(fields: [foodId], references: [id], onDelete: Cascade)
  grams    Float
  position Int        @default(0)

  @@index([presetId])
  @@index([foodId])
}

/**
 * ── Accounts ─────────────────────────────────────────────────────────────
 * The four models below are Auth.js's required shape (User, Account, Session,
 * VerificationToken). Field names are dictated by @auth/prisma-adapter and must
 * not be renamed, which is why they break this file's usual naming style.
 */

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?

  /// Grants the admin screen, where the invite list is managed. Held on the
  /// row rather than in an env var so the master account survives redeploys
  /// and can be handed over without a code change.
  isAdmin Boolean @default(false)

  createdAt DateTime @default(now())

  accounts Account[]
  sessions Session[]

  entries       DailyEntry[]
  meetings      Meeting[]
  meals         MealEntry[]
  sets          WorkoutSet[]
  photos        Photo[]
  planDays      PlanDay[]
  presets       MealPreset[]
  carried       CarriedExercise[]
  foods         Food[]
  settings      Settings?
  subscriptions PushSubscription[]
  notifications NotificationLog[]
  aiUsage       AiUsage[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

/// One row per person per day, counting AI photo estimates.
///
/// Vision calls are the only thing in this app that costs money per use, so
/// they are the only thing metered. Counted in a table rather than in memory
/// because the app restarts on every deploy and runs behind a process manager
/// that can restart it at any time — an in-memory counter would hand everyone
/// a fresh allowance each time that happened.
model AiUsage {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Date key in the *user's* timezone, so the allowance resets at their
  /// midnight rather than the server's — the server is in Singapore.
  date  String
  count Int    @default(0)

  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}

/// The invite list. Sole source of truth for who may sign in — there is no
/// env-var equivalent, so access is managed from the admin screen rather than
/// by editing a file on the server and restarting.
model AllowedEmail {
  id      String   @id @default(cuid())
  email   String   @unique
  note    String   @default("")
  /// Email of the admin who added this address, for an audit trail. Empty for
  /// rows created by the migration that seeded the first account.
  addedBy String   @default("")
  addedAt DateTime @default(now())
}
