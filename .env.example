# Local dev: SQLite file, zero setup.
# Deploy / cross-device sync: swap in a postgres:// URL (Neon, Supabase, Vercel
# Postgres). The datasource provider follows this URL automatically.
#
# IMPORTANT for any *pooled* Postgres URL (Neon's "-pooler" host, Supabase's
# pgbouncer port): append `pgbouncer=true`. It tells Prisma not to use server-side
# prepared statements, which the pooler caches and reuses across connections.
# Without it, any migration that changes a column's TYPE makes every later query
# fail with `cached plan must not change result type` — and restarting the app
# does not clear it, because the stale plan lives on the pooler, not your process.
#
#   postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true
DATABASE_URL="file:./dev.db"

# Required for the food-photo estimate. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""

# Optional: override the vision model used for photo estimates.
# ANTHROPIC_MODEL="claude-sonnet-4-5"

# Required only for identity-linked API keys (ones issued to a user rather than
# directly to a workspace). Without it those keys are rejected with
# "anthropic-workspace-id is required". Find it in the Anthropic Console URL when
# viewing a workspace, or under Settings → Workspaces.
# ANTHROPIC_WORKSPACE_ID="

# ── Photo storage: Cloudflare R2 ────────────────────────────────────────────
# Progress photos and food photos are stored as objects in R2, not as base64 in
# the database. Free tier is 10 GB with no egress charge — thousands of photos.
#
# Get these from the Cloudflare dashboard:
#   R2_ACCOUNT_ID        R2 → Overview, "Account ID" in the right-hand panel
#   R2_ACCESS_KEY_ID     R2 → Manage API Tokens → Create (Object Read & Write)
#   R2_SECRET_ACCESS_KEY shown once when the token is created — save it then
#   R2_BUCKET            the bucket name; this project uses "gains"
#   R2_PUBLIC_URL        bucket → Settings → Public Development URL (r2.dev),
#                        or a custom domain. PUBLIC ACCESS MUST BE ENABLED or
#                        every image 404s even though the upload succeeded.
#
# Objects are keyed <kind>/<year>/<month>/<id>.jpg, e.g.
#   progress/2026/09/8f3c1d….jpg
#   meal/2026/09/2b90aa….jpg
# so the bucket stays browsable and a lifecycle rule can target old months.
#
# Leave these blank and the app still runs — the photo button returns a clear
# "not configured" message naming the missing variables.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="gains"          # or R2_BUCKET_NAME — both are accepted
R2_PUBLIC_URL="

# ── Web Push notifications ──────────────────────────────────────────────────
# Generate once with:  npm run push:keys
# VAPID is how a push service (FCM, Mozilla, Apple) verifies notifications
# really came from this server. Regenerating the pair invalidates every existing
# subscription — every device silently stops receiving until it re-subscribes —
# so generate once and leave it alone.
#
# Requires a persistent server process: the scheduler in src/instrumentation.ts
# polls every 5 minutes and sends when the local reminder time has passed and
# the day is still incomplete. On serverless there is nothing running at 9pm.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@yourdomain.com"
