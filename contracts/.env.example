# Contracts project only. Deliberately separate from the PWA's .env —
# nothing here should ever see DATABASE_URL, and the app must never see a
# private key.

# ── Deploying ───────────────────────────────────────────────────────────────
SEPOLIA_RPC_URL="https://sepolia.infura.io/v3/your-key"
# Funded with Sepolia ETH. A throwaway key — never one that holds real funds.
DEPLOYER_PRIVATE_KEY=""
ETHERSCAN_API_KEY=""

# Defaults to the deployer when unset.
ADMIN_ADDRESS=""
TREASURY_ADDRESS=""

# ── Token and economics ─────────────────────────────────────────────────────
TOKEN_NAME="Goal Token"
TOKEN_SYMBOL="GOAL"
TOKEN_CAP="1000000"
# Basis points. The contract refuses anything above 2000 (20%), whatever is set.
PLATFORM_FEE_BPS="1000"
REWARD_RATE_BPS="2000"
# Starting float minted to the deployer so accounts have something to stake.
INITIAL_MINT="10000"

# ── Buyback ─────────────────────────────────────────────────────────────────
# No default on purpose: a hardcoded router on a network whose pools are empty
# would look configured and swap nothing. Local runs deploy a mock instead.
DEX_ROUTER_ADDRESS=""

# ── Anchoring ───────────────────────────────────────────────────────────────
LOGS_FILE="scripts/logs.json"
# PERIOD_START / PERIOD_END default to the min and max timestamp in the file.
# PROVE_LOG_ID="clog…"   # also print the proof for one entry
# DRY_RUN="1"            # compute the root without sending a transaction
