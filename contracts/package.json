{
  "name": "gains-log-contracts",
  "version": "1.0.0",
  "private": true,
  "description": "Tokenised goal staking for Gains Log. Deliberately isolated from the PWA: Hardhat's dependency tree is larger than the whole app's, and nothing here belongs in a phone's bundle.",
  "scripts": {
    "build": "hardhat compile",
    "test": "hardhat test",
    "deploy:sepolia": "hardhat run scripts/deploy.ts --network sepolia",
    "deploy:local": "hardhat run scripts/deploy.ts --network hardhat",
    "anchor": "hardhat run scripts/anchor.ts --network sepolia",
    "node": "hardhat node"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@types/node": "^22.0.0",
    "dotenv": "^16.4.5",
    "hardhat": "^2.22.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.1.0",
    "@openzeppelin/merkle-tree": "^1.0.7"
  }
}
