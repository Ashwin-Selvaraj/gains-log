{
  "name": "gains-log",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/set-db-provider.mjs && prisma generate",
    "dev": "next dev",
    "prebuild": "node scripts/set-db-provider.mjs && prisma generate && prisma db push --skip-generate",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:push": "node scripts/set-db-provider.mjs && prisma db push",
    "db:studio": "node scripts/set-db-provider.mjs && prisma studio",
    "db:seed": "node scripts/set-db-provider.mjs && prisma generate && node --experimental-strip-types prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@prisma/client": "^6.19.3",
    "next": "^16.3.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.30.0",
    "eslint-config-next": "^16.3.2",
    "postcss": "^8.5.6",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3"
  }
}

